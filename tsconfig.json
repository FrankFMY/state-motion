{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun",
      "node",
      "svelte"
    ],
    "customConditions": [
      "svelte"
    ],
    "paths": {
      "@frankfmy/state-motion": [
        "./packages/core/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts"
  ],
  "exclude": [
    "packages/*/dist",
    "node_modules"
  ]
}
